{% comment %}
  Social Boost - Estimated Delivery Date Widget
  Place this block on product pages to show delivery estimates
{% endcomment %}

{% style %}
  .sb-edd-widget {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: {{ block.settings.text_color }};
    max-width: 100%;
    margin: 16px 0;
  }

  .sb-edd-banner {
    border: 1px dashed {{ block.settings.border_color | default: '#cccccc' }};
    padding: 16px 20px;
    margin-bottom: 8px;
    background: {{ block.settings.bg_color }};
    border-radius: 4px;
  }

  .sb-edd-shipping-line {
    margin: 0 0 6px 0;
    font-size: 14px;
    line-height: 1.4;
    color: {{ block.settings.text_color }};
  }

  .sb-edd-timer-line {
    margin: 0;
    font-size: 13px;
    color: #555;
    line-height: 1.6;
  }
  
  .sb-edd-timer-line strong {
    color: {{ block.settings.accent_color }};
  }

  .sb-edd-progress-row {
    display: flex;
    align-items: stretch;
    border: 1px solid #e0e0e0;
    background: #fff;
    border-radius: 4px;
    overflow: hidden;
  }

  .sb-edd-step-box {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px 10px;
    border-right: 1px solid #e0e0e0;
    text-align: center;
  }

  .sb-edd-step-box:last-child {
    border-right: none;
  }

  .sb-edd-step-icon {
    width: 24px;
    height: 24px;
    margin-bottom: 10px;
    color: {{ block.settings.text_color }};
  }

  .sb-edd-step-label {
    font-size: 14px;
    font-weight: 700;
    color: #111;
    margin-bottom: 4px;
  }

  .sb-edd-step-date {
    font-size: 12px;
    color: #666;
  }

  .sb-edd-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    background: #fff;
    border-top: 1px solid #e0e0e0;
    border-bottom: 1px solid #e0e0e0;
  }
  
  .sb-edd-arrow svg {
    width: 16px;
    height: 16px;
    color: #999;
  }

  @media (max-width: 480px) {
    .sb-edd-banner { padding: 12px 14px; }
    .sb-edd-step-box { padding: 14px 6px; }
    .sb-edd-step-label { font-size: 11px; }
    .sb-edd-step-date { font-size: 10px; }
    .sb-edd-arrow { width: 18px; }
  }
{% endstyle %}

{% assign country_code = block.settings.country | default: 'IN' %}
{% assign flag = '' %}
{% assign country_name = '' %}

{% case country_code %}
  {% when 'IN' %}{% assign flag = '🇮🇳' %}{% assign country_name = 'India' %}
  {% when 'US' %}{% assign flag = '🇺🇸' %}{% assign country_name = 'United States' %}
  {% when 'GB' %}{% assign flag = '🇬🇧' %}{% assign country_name = 'United Kingdom' %}
  {% when 'CA' %}{% assign flag = '🇨🇦' %}{% assign country_name = 'Canada' %}
  {% when 'AU' %}{% assign flag = '🇦🇺' %}{% assign country_name = 'Australia' %}
  {% when 'DE' %}{% assign flag = '🇩🇪' %}{% assign country_name = 'Germany' %}
  {% when 'FR' %}{% assign flag = '🇫🇷' %}{% assign country_name = 'France' %}
  {% when 'JP' %}{% assign flag = '🇯🇵' %}{% assign country_name = 'Japan' %}
  {% when 'BR' %}{% assign flag = '🇧🇷' %}{% assign country_name = 'Brazil' %}
  {% when 'AE' %}{% assign flag = '🇦🇪' %}{% assign country_name = 'UAE' %}
  {% else %}{% assign flag = '🌍' %}{% assign country_name = 'International' %}
{% endcase %}

<div class="sb-edd-widget" id="sb-edd-widget-{{ block.id }}" {{ block.shopify_attributes }}>
  <div class="sb-edd-banner">
    <p class="sb-edd-shipping-line">
      Free Shipping to <span class="sb-edd-flag">{{ flag }}</span> <strong>{{ country_name }}</strong>
    </p>
    <p class="sb-edd-timer-line">
      Order within the next <strong id="sb-edd-countdown-{{ block.id }}">--</strong> to get it by <strong id="sb-edd-delivery-{{ block.id }}">--</strong>
    </p>
  </div>
  
  {% if block.settings.show_timeline %}
  <div class="sb-edd-progress-row">
    <!-- Step 1 -->
    <div class="sb-edd-step-box">
        <svg class="sb-edd-step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
            <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
        <div class="sb-edd-step-label">Ordered</div>
        <div class="sb-edd-step-date" id="sb-edd-ordered-{{ block.id }}">Today</div>
    </div>

    <div class="sb-edd-arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M9 5l7 7-7 7" /></svg>
    </div>

    <!-- Step 2 -->
    <div class="sb-edd-step-box">
        <svg class="sb-edd-step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
            <path d="M8 7h12l-2 13H6L4 7H2M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2" />
            <circle cx="9" cy="20" r="1" /><circle cx="17" cy="20" r="1" />
        </svg>
        <div class="sb-edd-step-label">Order Ready</div>
        <div class="sb-edd-step-date" id="sb-edd-ready-{{ block.id }}">--</div>
    </div>

    <div class="sb-edd-arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M9 5l7 7-7 7" /></svg>
    </div>

    <!-- Step 3 -->
    <div class="sb-edd-step-box">
        <svg class="sb-edd-step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" />
            <circle cx="12" cy="9" r="2.5" />
        </svg>
        <div class="sb-edd-step-label">Delivered</div>
        <div class="sb-edd-step-date" id="sb-edd-date-final-{{ block.id }}">--</div>
    </div>
  </div>
  {% endif %}
</div>

<script>
(function() {
  const settings = {
    minHandlingDays: {{ block.settings.min_handling_days | default: 1 }},
    maxHandlingDays: {{ block.settings.max_handling_days | default: 3 }},
    minShippingDays: {{ block.settings.min_shipping_days | default: 7 }},
    maxShippingDays: {{ block.settings.max_shipping_days | default: 12 }},
    cutoffHour: {{ block.settings.cutoff_hour | default: 17 }},
  };
  
  const blockId = '{{ block.id }}';
  
  function formatDate(date) {
    return date.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
  }
  
  function formatShortDate(date) {
    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }
  
  function calculateDates() {
    const now = new Date();
    const startDay = now.getHours() < settings.cutoffHour ? 0 : 1;
    
    // Order Ready
    const minReadyDate = new Date(now);
    minReadyDate.setDate(minReadyDate.getDate() + startDay + settings.minHandlingDays);
    const maxReadyDate = new Date(now);
    maxReadyDate.setDate(maxReadyDate.getDate() + startDay + settings.maxHandlingDays);
    
    // Delivered
    const minDeliveryDate = new Date(now);
    minDeliveryDate.setDate(minDeliveryDate.getDate() + startDay + settings.minHandlingDays + settings.minShippingDays);
    const maxDeliveryDate = new Date(now);
    maxDeliveryDate.setDate(maxDeliveryDate.getDate() + startDay + settings.maxHandlingDays + settings.maxShippingDays);
    
    return {
        ordered: formatShortDate(now),
        readyMin: formatShortDate(minReadyDate),
        readyMax: formatShortDate(maxReadyDate),
        deliveryMin: formatShortDate(minDeliveryDate),
        deliveryMax: formatShortDate(maxDeliveryDate),
        fullDeliveryMin: formatDate(minDeliveryDate),
        fullDeliveryMax: formatDate(maxDeliveryDate)
    };
  }
  
  function calculateCountdown() {
    const now = new Date();
    const cutoffToday = new Date(now);
    cutoffToday.setHours(settings.cutoffHour, 0, 0, 0);
    
    if (now >= cutoffToday) {
      cutoffToday.setDate(cutoffToday.getDate() + 1);
    }
    
    const diff = cutoffToday.getTime() - now.getTime();
    const hours = Math.floor(diff / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);
    
    return `${hours}h ${minutes}m ${seconds}s`;
  }
  
  function updateWidget() {
    const dates = calculateDates();
    const countdown = calculateCountdown();
    
    const countdownEl = document.getElementById('sb-edd-countdown-' + blockId);
    if (countdownEl) countdownEl.textContent = countdown;
    
    const deliveryBannerEl = document.getElementById('sb-edd-delivery-' + blockId);
    if (deliveryBannerEl) deliveryBannerEl.textContent = dates.fullDeliveryMin;
    
    // Progress Steps
    const orderedEl = document.getElementById('sb-edd-ordered-' + blockId);
    if (orderedEl) orderedEl.textContent = dates.ordered;
    
    const readyEl = document.getElementById('sb-edd-ready-' + blockId);
    if (readyEl) readyEl.textContent = `${dates.readyMin} - ${dates.readyMax}`;
    
    const finalDateEl = document.getElementById('sb-edd-date-final-' + blockId);
    if (finalDateEl) finalDateEl.textContent = `${dates.deliveryMin} - ${dates.deliveryMax}`;
  }
  
  updateWidget();
  setInterval(updateWidget, 1000);
})();
</script>

{% schema %}
{
  "name": "Delivery Estimator",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "country",
      "label": "Target Country",
      "options": [
        { "value": "IN", "label": "India (IN)" },
        { "value": "US", "label": "United States (US)" },
        { "value": "GB", "label": "United Kingdom (GB)" },
        { "value": "CA", "label": "Canada (CA)" },
        { "value": "AU", "label": "Australia (AU)" },
        { "value": "DE", "label": "Germany (DE)" },
        { "value": "FR", "label": "France (FR)" },
        { "value": "JP", "label": "Japan (JP)" },
        { "value": "BR", "label": "Brazil (BR)" },
        { "value": "AE", "label": "UAE (AE)" }
      ],
      "default": "IN"
    },
    {
      "type": "header",
      "content": "Processing Time"
    },
    {
      "type": "range",
      "id": "min_handling_days",
      "min": 0,
       "max": 10,
      "step": 1,
      "default": 1,
      "label": "Min Handling Days"
    },
    {
      "type": "range",
      "id": "max_handling_days",
      "min": 0,
      "max": 14,
      "step": 1,
      "default": 3,
      "label": "Max Handling Days"
    },
    {
      "type": "header",
      "content": "Shipping Time"
    },
    {
      "type": "range",
      "id": "min_shipping_days",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 7,
      "label": "Min Shipping Days"
    },
    {
      "type": "range",
      "id": "max_shipping_days",
      "min": 1,
      "max": 45,
      "step": 1,
      "default": 12,
      "label": "Max Shipping Days"
    },
    {
      "type": "header",
      "content": "Cutoff Time"
    },
    {
      "type": "range",
      "id": "cutoff_hour",
      "min": 0,
      "max": 23,
      "step": 1,
      "default": 17,
      "label": "Cutoff Hour (24h)",
      "info": "Orders after this ship next day"
    },
    {
      "type": "header",
      "content": "Display"
    },
    {
      "type": "checkbox",
      "id": "show_timeline",
      "default": true,
      "label": "Show Timeline"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "default": "#ffffff",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#333333",
      "label": "Text Color"
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#22c55e",
      "label": "Accent Color"
    },
    {
        "type": "color",
        "id": "border_color",
        "default": "#cccccc",
        "label": "Border Color"
    }
  ]
}
{% endschema %}
